{
  "components": {
    "schemas": {
      "CalculatorEvaluateInput": {
        "additionalProperties": false,
        "properties": {
          "left": {
            "format": "int64",
            "maximum": 1000000,
            "minimum": -1000000,
            "type": "integer"
          },
          "operator": {
            "$ref": "#/components/schemas/CalculatorOperator"
          },
          "right": {
            "format": "int64",
            "maximum": 1000000,
            "minimum": -1000000,
            "type": "integer"
          }
        },
        "required": [
          "left",
          "operator",
          "right"
        ],
        "type": "object"
      },
      "CalculatorOperator": {
        "description": "What to do with the two operands.",
        "enum": [
          "add",
          "subtract",
          "multiply",
          "divide"
        ],
        "type": "string"
      },
      "CalculatorRecallInput": {
        "additionalProperties": false,
        "properties": {
          "slot": {
            "$ref": "#/components/schemas/CalculatorSlotName"
          }
        },
        "required": [
          "slot"
        ],
        "type": "object"
      },
      "CalculatorResult": {
        "additionalProperties": false,
        "properties": {
          "remainder": {
            "description": "For divide only: what is left over.",
            "format": "int64",
            "type": "integer"
          },
          "value": {
            "description": "The result. For divide, the quotient rounded towards zero.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "CalculatorResultStoredEvent": {
        "additionalProperties": false,
        "description": "A result was stored in a memory slot.",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/CalculatorResult"
          },
          "slot": {
            "$ref": "#/components/schemas/CalculatorSlotName"
          },
          "storedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "result",
          "slot",
          "storedAt"
        ],
        "type": "object",
        "x-modura-event": "calculator.resultStored"
      },
      "CalculatorSlotName": {
        "description": "A memory slot, such as `answer`.",
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "CalculatorStoreInput": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "$ref": "#/components/schemas/CalculatorResult"
          },
          "slot": {
            "$ref": "#/components/schemas/CalculatorSlotName"
          }
        },
        "required": [
          "result",
          "slot"
        ],
        "type": "object"
      },
      "CalculatorStoredResult": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "$ref": "#/components/schemas/CalculatorResult"
          },
          "slot": {
            "$ref": "#/components/schemas/CalculatorSlotName"
          },
          "storedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "result",
          "slot",
          "storedAt"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Platform code or qualified domain code. Clients match on this, never on message.",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amountMinor": {
            "description": "Amount in the currency's minor unit, for example cents.",
            "format": "int64",
            "type": "integer"
          },
          "currency": {
            "description": "ISO 4217 code.",
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Calculator: calculator",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/calculator.evaluate": {
      "post": {
        "description": "Apply an operator to two integers.",
        "operationId": "calculatorEvaluate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculatorEvaluateInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculatorResult"
                }
              }
            },
            "description": "Success."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_FAILED",
            "x-modura-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAUTHENTICATED",
            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "calculator.DIVISION_BY_ZERO",
            "x-modura-error-codes": [
              "calculator.DIVISION_BY_ZERO"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INTERNAL",
            "x-modura-error-codes": [
              "INTERNAL"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "calculator.evaluate",
        "tags": [
          "calculator"
        ],
        "x-modura-idempotent": false,
        "x-modura-kind": "query",
        "x-modura-operation": "calculator.evaluate",
        "x-modura-requires": [
          "calculator.use"
        ]
      }
    },
    "/v1/calculator.recall": {
      "post": {
        "description": "Read the result stored in a memory slot.",
        "operationId": "calculatorRecall",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculatorRecallInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculatorStoredResult"
                }
              }
            },
            "description": "Success."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_FAILED",
            "x-modura-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAUTHENTICATED",
            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "calculator.SLOT_NOT_FOUND",
            "x-modura-error-codes": [
              "calculator.SLOT_NOT_FOUND"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INTERNAL",
            "x-modura-error-codes": [
              "INTERNAL"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "calculator.recall",
        "tags": [
          "calculator"
        ],
        "x-modura-idempotent": false,
        "x-modura-kind": "query",
        "x-modura-operation": "calculator.recall",
        "x-modura-requires": [
          "calculator.use"
        ]
      }
    },
    "/v1/calculator.store": {
      "post": {
        "description": "Store a result in a memory slot, replacing what was there. Retrying with the same key stores it once.",
        "operationId": "calculatorStore",
        "parameters": [
          {
            "description": "Unique per attempt, for example per checkout. Retrying with the same key returns the original result.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculatorStoreInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculatorStoredResult"
                }
              }
            },
            "description": "Success.",
            "headers": {
              "Idempotent-Replayed": {
                "description": "True when this response replays an earlier request with the same idempotency key.",
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_FAILED",
            "x-modura-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAUTHENTICATED",
            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "IDEMPOTENCY_IN_PROGRESS, IDEMPOTENCY_KEY_REUSED",
            "x-modura-error-codes": [
              "IDEMPOTENCY_IN_PROGRESS",
              "IDEMPOTENCY_KEY_REUSED"
            ]
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "calculator.MEMORY_FULL",
            "x-modura-error-codes": [
              "calculator.MEMORY_FULL"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INTERNAL",
            "x-modura-error-codes": [
              "INTERNAL"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "calculator.store",
        "tags": [
          "calculator"
        ],
        "x-modura-idempotent": true,
        "x-modura-kind": "command",
        "x-modura-operation": "calculator.store",
        "x-modura-requires": [
          "calculator.write"
        ]
      }
    }
  }
}
