{
  "components": {
    "schemas": {
      "CalculatorResult": {
        "additionalProperties": false,
        "properties": {
          "remainder": {
            "description": "For divide only: what is left over.",
            "format": "int64",
            "type": "integer"
          },
          "value": {
            "description": "The result. For divide, the quotient rounded towards zero.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "CalculatorResultStoredEvent": {
        "additionalProperties": false,
        "description": "A result was stored in a memory slot.",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/CalculatorResult"
          },
          "slot": {
            "$ref": "#/components/schemas/CalculatorSlotName"
          },
          "storedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "result",
          "slot",
          "storedAt"
        ],
        "type": "object",
        "x-modura-event": "calculator.resultStored"
      },
      "CalculatorSlotName": {
        "description": "A memory slot, such as `answer`.",
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Platform code or qualified domain code. Clients match on this, never on message.",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amountMinor": {
            "description": "Amount in the currency's minor unit, for example cents.",
            "format": "int64",
            "type": "integer"
          },
          "currency": {
            "description": "ISO 4217 code.",
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "type": "object"
      },
      "TapeEntry": {
        "additionalProperties": false,
        "properties": {
          "slot": {
            "$ref": "#/components/schemas/CalculatorSlotName"
          },
          "storedAt": {
            "format": "date-time",
            "type": "string"
          },
          "value": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "slot",
          "storedAt",
          "value"
        ],
        "type": "object"
      },
      "TapeListInput": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "format": "int64",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TapeListOutput": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/TapeEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Calculator: tape",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/tape.list": {
      "post": {
        "description": "The latest stored results, newest first.",
        "operationId": "tapeList",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TapeListInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TapeListOutput"
                }
              }
            },
            "description": "Success."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "VALIDATION_FAILED",
            "x-modura-error-codes": [
              "VALIDATION_FAILED"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAUTHENTICATED",
            "x-modura-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "FORBIDDEN",
            "x-modura-error-codes": [
              "FORBIDDEN"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "RATE_LIMITED",
            "x-modura-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "INTERNAL",
            "x-modura-error-codes": [
              "INTERNAL"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "UNAVAILABLE",
            "x-modura-error-codes": [
              "UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "tape.list",
        "tags": [
          "tape"
        ],
        "x-modura-idempotent": false,
        "x-modura-kind": "query",
        "x-modura-operation": "tape.list",
        "x-modura-requires": [
          "tape.read"
        ]
      }
    }
  }
}
