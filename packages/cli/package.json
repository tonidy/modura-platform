{
  "name": "@modura/cli",
  "version": "1.0.0-rc.5",
  "type": "module",
  "bin": {
    "modura": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate-check": "tsx src/main.ts generate --check --strict",
    "registry-check": "tsx src/main.ts registry verify && tsx src/main.ts compat --against registry",
    "test": "vitest run"
  },
  "dependencies": {
    "@modura/compiler": "workspace:*",
    "@modura/generator-mcp": "workspace:*",
    "@modura/generator-openapi": "workspace:*",
    "@modura/generator-sdk-ts": "workspace:*",
    "@modura/module-registry": "workspace:*",
    "@modura/schema": "workspace:*",
    "@modura/sdk": "workspace:*",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@modura/example-calculator": "workspace:*",
    "fast-check": "4.10.2"
  },
  "license": "MIT",
  "repository": "https://github.com/tonidy/modura-platform",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/config.js",
  "types": "./dist/config.d.ts",
  "description": "Modura CLI for generating artifacts, compatibility checks, and contract releases."
}
