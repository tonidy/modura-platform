{
  "name": "@modura/compiler",
  "version": "1.0.0-rc.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/arbitraries.d.ts",
      "import": "./dist/testing/arbitraries.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modura/runtime-contracts": "workspace:*",
    "@modura/schema": "workspace:*",
    "ajv": "8.20.0",
    "fast-check": "4.10.2"
  },
  "devDependencies": {},
  "license": "MIT",
  "repository": "https://github.com/tonidy/modura-platform",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Compile, validate, hash, and compare Modura contract IR documents."
}
