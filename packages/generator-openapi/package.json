{
  "name": "@modura/generator-openapi",
  "version": "1.0.0-rc.5",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modura/compiler": "workspace:*",
    "@modura/runtime-contracts": "workspace:*"
  },
  "devDependencies": {
    "@modura/example-calculator": "workspace:*",
    "@modura/schema": "workspace:*"
  },
  "license": "MIT",
  "repository": "https://github.com/tonidy/modura-platform",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Generate service-scoped OpenAPI documents from Modura IR."
